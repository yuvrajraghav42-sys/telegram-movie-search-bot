# Telegram Bot Token
# Get it from BotFather on Telegram (@BotFather)
# Instructions: Message @BotFather and use /newbot command
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OMDB API Key (Primary Movie Database)
# Sign up at https://www.omdbapi.com/
# Free tier available with limitations
OMDB_API_KEY=your_omdb_api_key_here

# TMDB API Key (Movie Database for streaming info)
# Sign up at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Bot timeout (seconds)
BOT_TIMEOUT=30
